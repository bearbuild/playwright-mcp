{
  "name": "@bearbuild/playwright-mcp",
  "version": "1.0.2",
  "description": "Cloudflare Playwright Tools for MCP (bearbuild fork)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bearbuild/playwright-mcp.git"
  },
  "homepage": "https://playwright.dev",
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm ci && npx vite build"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "default": "./lib/esm/index.js"
    }
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.19.0",
    "commander": "^13.1.0",
    "debug": "^4.4.1",
    "mime": "^4.0.7",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250725.0",
    "vite": "^7.0.6"
  }
}
